PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/visitrack

# Long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
GATE_KEY=change-me-gate-key

# Flask ML service
ML_URL=http://127.0.0.1:5001
ML_SERVICE_KEY=

# First admin account, created only when the database has no admin yet
ADMIN_EMAIL=admin@visitrack.local
ADMIN_PASSWORD=change-me

CORS_ORIGIN=http://localhost:5173
# Ignore repeat check-ins of the same person at the same gate within this many seconds
CHECKIN_COOLDOWN_SEC=60
